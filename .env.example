# Copy to .env — never commit real API keys (.env is gitignored).
#
# After extracting the data zip into the repo root you should have:
#   ./ap_inbox_candidate.sql
#   ./attachments/

# Postgres
POSTGRES_DB=ap_inbox
POSTGRES_USER=ap
POSTGRES_PASSWORD=ap_dev_password
POSTGRES_PORT=5432

# Used by local scripts / Alembic outside Docker
DATABASE_URL=postgresql+asyncpg://ap:ap_dev_password@localhost:5432/ap_inbox
DATABASE_URL_SYNC=postgresql+psycopg2://ap:ap_dev_password@localhost:5432/ap_inbox

# Attachments (extracted zip folder)
ATTACHMENTS_DIR=./attachments

# CORS for Next.js
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# LLM — any OpenAI-compatible host (chat + embeddings)
#
# Required shape: API key, base URL ending in /v1, chat model, embed model.
# LLM_API_KEY / LLM_BASE_URL win. OPENAI_API_KEY / OPENAI_BASE_URL are fallbacks.
# EMBED_BASE_URL and EMBED_API_KEY are optional and default to the chat values.
#
# LLM_PROVIDER=ollama adds Ollama's num_ctx on each call. Any other value
# (openai, groq, openrouter, together, vllm, …) is a plain /v1 request.
#
# The block below is the local Ollama preset (no cloud key). To switch, replace
# it with one of the commented presets further down, then re-run denote
# without --skip-chunks if EMBED_MODEL changed (stored vectors must match).
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
# Leave LLM_BASE_URL unset for Docker. The api container uses OPENAI_BASE_URL_DOCKER.
# Set it only when chat should go somewhere other than that Ollama URL.
# LLM_BASE_URL=
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
OPENAI_MODEL=qwen3:14b
LLM_MODEL=qwen3-14b-16k
EMBED_MODEL=nomic-embed-text
# EMBED_BASE_URL=
# EMBED_API_KEY=

# --- Preset: OpenAI ---------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# --- Preset: any other OpenAI-compatible host (Groq, Together, OpenRouter,
#     vLLM, LM Studio, Ollama on another machine, …) -------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://your-host.example/v1
# LLM_MODEL=your-chat-model
# EMBED_MODEL=your-embed-model
# EMBED_BASE_URL=https://your-embed-host.example/v1
# EMBED_API_KEY=your-embed-key

LLM_NUM_CTX=16384
LLM_SOFT_PROMPT_BUDGET=13000
LLM_RESERVED_COMPLETION=2384
LLM_MAX_TOOL_ITERATIONS=6
LLM_MAX_CHUNKS_PER_TURN=12
LLM_MAX_ATTACHMENT_CHARS=20000
CHUNK_TOKENS=768
CHUNK_OVERLAP=128

# Do NOT publish compose ollama on 11434 while the host daemon uses that port — it shadows the host.
# Optional CPU Ollama in Compose: docker compose --profile local-llm up -d
#   then set OPENAI_BASE_URL_DOCKER=http://ollama:11434/v1

# Internal tool gateway (dev placeholder — change if exposing beyond localhost)
INTERNAL_API_TOKEN=dev-internal-token-change-me
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

API_PORT=8000
WEB_PORT=3000
OLLAMA_PORT=11434
OLLAMA_CONTEXT_LENGTH=16384
