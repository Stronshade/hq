# Copy to .env — placeholders only. Never commit real API keys.
#
# After extracting the data zip into the repo root you should have:
#   ./ap_inbox_candidate.sql
#   ./attachments/

# Postgres
POSTGRES_DB=ap_inbox
POSTGRES_USER=ap
POSTGRES_PASSWORD=ap_dev_password
POSTGRES_PORT=5432

# Used by local scripts / Alembic outside Docker
DATABASE_URL=postgresql+asyncpg://ap:ap_dev_password@localhost:5432/ap_inbox
DATABASE_URL_SYNC=postgresql+psycopg2://ap:ap_dev_password@localhost:5432/ap_inbox

# Attachments (extracted zip folder)
ATTACHMENTS_DIR=./attachments

# CORS for Next.js
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM — local Ollama only for this take-home (no OpenAI cloud key required)
LLM_PROVIDER=ollama
OPENAI_API_KEY=ollama
# Host machine (scripts / browser-side expectations)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3:14b
LLM_MODEL=qwen3-14b-16k
LLM_NUM_CTX=16384
LLM_SOFT_PROMPT_BUDGET=13000
LLM_RESERVED_COMPLETION=2384
LLM_MAX_TOOL_ITERATIONS=6
LLM_MAX_CHUNKS_PER_TURN=12
LLM_MAX_ATTACHMENT_CHARS=20000
EMBED_MODEL=nomic-embed-text
CHUNK_TOKENS=768
CHUNK_OVERLAP=128

# Prefer host GPU Ollama when api/denote run inside Docker:
OPENAI_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
# Do NOT publish compose ollama on 11434 while the host daemon uses that port — it shadows the host.
# Optional CPU Ollama in Compose: docker compose --profile local-llm up -d
#   then set OPENAI_BASE_URL_DOCKER=http://ollama:11434/v1

# Internal tool gateway (dev placeholder — change if exposing beyond localhost)
INTERNAL_API_TOKEN=dev-internal-token-change-me
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

API_PORT=8000
WEB_PORT=3000
OLLAMA_PORT=11434
OLLAMA_CONTEXT_LENGTH=16384
